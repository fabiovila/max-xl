<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop">
  <id>com.max_xl.MaxXL</id>
  <metadata_license>MIT</metadata_license>
  <project_license>MIT</project_license>
  <name>Max XL</name>
  <summary>A lightweight text editor written in Lua</summary>
  <content_rating type="oars-1.0" />
  <launchable type="desktop-id">com.max_xl.MaxXL.desktop</launchable>

  <description>
    <p>
      Max XL is a text editor and development tool written mainly in Lua,
      on top of a minimalistic C core using the SDL2 graphics library.
    </p>
    <p>
      Max XL is a fork of Lite XL (https://github.com/lite-xl/lite-xl) with a
      VS Code-style workflow. It is released under the MIT license.
    </p>
  </description>

  <url type="homepage">https://github.com/fabiovila/max-xl</url>

  <provides>
    <binary>max-xl</binary>
  </provides>

  @METAINFO_RELEASES@
</component>
