[Desktop Entry]
Type=Application
Version=1.0
Name=Max XL Workspace
Name[pt_BR]=Workspace do Max XL
Comment=Open this directory as a Max XL workspace
Comment[pt_BR]=Abrir este diretório como um workspace do Max XL
Exec=sh -c 'exec max-xl "$(dirname "$1")"' sh %f
Icon=max-xl
Terminal=false
Categories=Development;IDE;
MimeType=application/x-max-xl-workspace;
StartupNotify=false
