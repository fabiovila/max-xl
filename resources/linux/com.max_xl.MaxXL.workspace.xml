<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-max-xl-workspace">
    <comment>Max XL workspace</comment>
    <comment xml:lang="pt_BR">Workspace do Max XL</comment>
    <icon name="max-xl"/>
